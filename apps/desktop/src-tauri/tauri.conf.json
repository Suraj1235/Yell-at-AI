{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subtext Desktop",
  "version": "0.1.0",
  "identifier": "ai.subtext.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Subtext Desktop",
        "width": 760,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "global-shortcut": {},
    "shell": {
      "open": false
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
