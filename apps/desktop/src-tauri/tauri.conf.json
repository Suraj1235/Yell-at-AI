{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Subtext Desktop",
  "version": "0.1.0",
  "identifier": "ai.subtext.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Subtext Desktop",
        "width": 760,
        "height": 680,
        "resizable": true
      },
      {
        "label": "pill",
        "url": "pill.html",
        "title": "Subtext overlay",
        "width": 180,
        "height": 48,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "shell": {
      "open": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Dictation that carries how you said it.",
    "longDescription": "Hold a hotkey, speak, and your words land in the focused app with a vocalcontext/v1 evidence block attached. Prosody analysis is local and model-free.",
    "copyright": "Copyright (c) Suraj Kuncham and Manish Sampathirao",
    "publisher": "Subtext",
    "licenseFile": "../../../LICENSE"
  }
}
