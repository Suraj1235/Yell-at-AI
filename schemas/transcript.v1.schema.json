{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://subtext.dev/schemas/transcript.v1.schema.json",
  "title": "Subtext Native Transcript Envelope v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "text", "source"],
  "properties": {
    "schema": {
      "const": "subtext/transcript/v1"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Transcript text produced by the host, OS, browser, or native voice model."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable transcript source, such as platform-native-voice, browser-dictation, or codex-voice."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "wordTimings": {
      "type": "array",
      "description": "Optional host word timestamps. Times are seconds in the canonical form.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["word", "start", "end"],
        "properties": {
          "word": { "type": "string", "minLength": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 },
          "phones": {
            "type": "array",
            "description": "Optional platform phone/phoneme timestamps for this word. Used to compute duration_frames without estimating phone count.",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["start", "end"],
              "properties": {
                "phone": { "type": "string" },
                "phoneme": { "type": "string" },
                "start": { "type": "number", "minimum": 0 },
                "end": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
